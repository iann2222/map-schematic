{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map-schematic/datapack.schema.json",
  "title": "Map Schematic Data Pack",
  "type": "object",
  "required": ["id", "version", "createdAt", "projection", "basemap", "geonames", "files"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?$",
      "allOf": [
        { "not": { "pattern": "\\.\\." } },
        {
          "not": {
            "pattern": "^(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$)"
          }
        }
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?$",
      "allOf": [
        { "not": { "pattern": "\\.\\." } },
        {
          "not": {
            "pattern": "^(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$)"
          }
        }
      ]
    },
    "createdAt": { "type": "string", "minLength": 1 },
    "projection": { "type": "string", "enum": ["EPSG:4326"] },
    "buildEnvironment": {
      "type": "object",
      "required": ["python", "geopandas", "pillow", "gdal"],
      "properties": {
        "python": { "type": "string", "minLength": 1 },
        "geopandas": { "type": "string", "minLength": 1 },
        "pillow": { "type": "string", "minLength": 1 },
        "gdal": { "type": "string", "minLength": 1 }
      }
    },
    "basemap": {
      "type": "object",
      "required": ["format", "layers"],
      "properties": {
        "format": { "type": "string", "enum": ["geojson"] },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "path"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "geonames": {
      "type": "object",
      "required": ["format", "dbPath", "languages"],
      "properties": {
        "format": { "type": "string", "enum": ["sqlite+fts"] },
        "dbPath": { "type": "string", "minLength": 1 },
        "languages": { "type": "array", "items": { "type": "string" } }
      }
    },
    "relief": {
      "type": ["object", "null"],
      "properties": {
        "format": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "projection": { "type": ["string", "null"] }
      },
      "required": ["format", "path"]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sizeBytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        }
      }
    }
  }
}
