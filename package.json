{
  "name": "map-schematic",
  "productName": "Map Schematic",
  "version": "0.1.0",
  "description": "Offline map schematic editor built with Electron.",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "main": "out/main/index.js",
  "scripts": {
    "build": "node scripts/clean-output.mjs && tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "postinstall": "electron-builder install-app-deps",
    "start": "electron .",
    "start:dev": "npm run build && electron .",
    "package:win": "node packaging/package-win.mjs",
    "test": "npm run test:typecheck && vitest run",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "test:watch": "vitest"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.43",
    "electron": "^41.7.1",
    "electron-builder": "26.0.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  }
}
